# =========================================================================
# Stage 1: Build Stage (ขั้นตอนการประกอบโค้ดและเตรียมทรัพยากร)
# =========================================================================
FROM golang:latest AS builder

# กำหนดโฟลเดอร์การทำงานในคอนเทนเนอร์
WORKDIR /app

# คัดลอกไฟล์จัดการโมดูล เพื่อใช้ระบบทำ Cache เลเยอร์โครงสร้าง Dependency
COPY go.mod go.sum ./
RUN go mod download

# คัดลอกโค้ดและโครงสร้างไฟล์ของแอปพลิเคชันทั้งหมดเข้ามาในระบบ
COPY . .

# สั่ง Compile แอปพลิเคชัน Go เป็นไฟล์เดี่ยวแบบสแตนด์อโลน (ขนาดไฟล์จะถูกบีบอัดและปิดตัวแปรโยงระบบ)
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o server main.go

# =========================================================================
# Stage 2: Final Runtime Stage (ขั้นตอนสร้างกล่องรันแอปที่มีน้ำหนักเบา)
# =========================================================================
FROM alpine:3.19

# ติดตั้งระบบรับรองความปลอดภัยเครือข่าย เผื่อในระบบแอปต้องมีการยิงออกไปคุยผ่าน httpsภายนอก
RUN apk add --no-cache ca-certificates

WORKDIR /root/

# ดึงเอาเฉพาะไฟล์เซิร์ฟเวอร์ไบนารีที่แพ็กสำเร็จมาจาก Stage 1
COPY --from=builder /app/server .

# ดึงหน้าต่างโฟลเดอร์เว็บหน้าบ้าน (HTML Frontend) มาจัดวางระบบเส้นทางเดียวกันให้ Fiber ค้นหาเจอ
COPY --from=builder /app/web ./web

# ประกาศพอร์ตที่ตัวโปรเจกต์นี้เปิดใช้งานรันระบบ
EXPOSE 8080

# คำสั่งเริ่มต้นทำงานเมื่อคอนเทนเนอร์นี้ถูกสั่งรัน
CMD ["./server"]
